# Copy this file to backend/.env and fill in real values. Never commit .env.

# Neon Postgres connection string. Get this from the Neon console
# (use the pooled connection string, and keep sslmode=require).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret used to sign JWTs. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme

JWT_EXPIRE_MINUTES=60

# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:3000,https://you-anime.vercel.app
